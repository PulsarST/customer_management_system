# Copy to .env and fill in your NVIDIA integrate.api token.
# The server reads AI_TOKEN from this file (optional) or from the real
# process environment. Without it, the chat endpoint replies with a clear
# "not configured" message instead of crashing.
AI_TOKEN=

# Optional overrides:
# DB_PATH=internal/handlers/db/mockup.db
# FRONTEND_DIR=../frontend
# AI_MODEL chooses the chat model (default: meta/llama-3.1-8b-instruct, fast).
# For slightly stronger reasoning but ~2-5x slower replies, use:
# AI_MODEL=qwen/qwen3-next-80b-a3b-instruct
